COMPOSE_PROJECT_NAME=tavern-awareness-showroom
AWARENESS_ENV_FILE=.env.example
APP_REVISION=development

# Shadow-safe defaults. Production paths must be absolute and outside RP Stack paths.
SHOWROOM_BIND_HOST=127.0.0.1
SHOWROOM_HOST_PORT=18011
AWARENESS_GATEWAY_DATA_DIR=./runtime/gateway
AWARENESS_STATE_DIR=./runtime/state
AWARENESS_SHOWROOM_COVER_DIR=./runtime/showroom-covers
AWARENESS_BACKUP_DIR=./runtime/backups

APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8088
CAMPAIGN_ID=awareness-showroom
SCENARIO_TYPE=training

DATABASE_URL=sqlite:////data/awareness_gateway.db
WORLD_STATE_PATH=/state/current.json
PARTY_STATE_ROOT=/state/parties
STATE_SCHEMA_PATH=/app/state-schema.json
WORLD_PACKS_PATH=/worldpacks

GATEWAY_AUTH_ENABLED=true
GATEWAY_BOOTSTRAP_ADMIN_USERNAME=admin
# Required before the first production start. Never commit the real value.
GATEWAY_BOOTSTRAP_ADMIN_PASSWORD=
GATEWAY_SESSION_COOKIE_NAME=awareness_gateway_session
GATEWAY_SESSION_TTL_SECONDS=1209600
# Keep false for plain HTTP. Set true only when the browser uses HTTPS.
GATEWAY_COOKIE_SECURE=false

SHOWROOM_VISITOR_COOKIE_NAME=awareness_showroom_visitor
SHOWROOM_VISITOR_TTL_SECONDS=2592000
SHOWROOM_COVER_DIR=/data/showroom-covers
SHOWROOM_COVER_MAX_BYTES=5242880

# Explicit provider selection; do not inherit the RP Stack environment.
LLM_PROVIDER=openrouter
LLM_API_BASE=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_FALLBACK_MODELS=openrouter/auto
LLM_DISABLED_MODELS=

OPENROUTER_API_BASE=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
SERVICE_OPENROUTER_API_KEY=
OPENROUTER_MODELS=openrouter/auto,openrouter/free,deepseek/deepseek-v4-flash,google/gemini-3.6-flash
OPENROUTER_FALLBACK_MODELS=openrouter/auto
OPENROUTER_MODEL_CATALOG_LIVE=true
PROVIDER_MODEL_CATALOG_TTL_SECONDS=86400

GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash
GEMINI_MODEL_CATALOG_LIVE=false

# Enable only together with compose.local-llm.yml or another reachable endpoint.
LOCAL_LLM_ENABLED=false
LOCAL_LLM_NETWORK=rp-llm
LOCAL_LLM_BASE_URL=http://rp-local-llm:8080/v1
LOCAL_LLM_MODEL_ALIAS=gemma-4-26b-a4b-it-rp-q4
LOCAL_LLM_CONTEXT_TOKENS=32768
LOCAL_LLM_TIMEOUT_SECONDS=240

NARRATIVE_MODEL=openrouter/auto
INTENT_MODEL=openrouter/auto
VALIDATOR_MODEL=openrouter/auto
SERVICE_MODEL_CHOICE=or-qwen-3.5-flash

MAX_REPAIR_ATTEMPTS=1
TRAINING_REPAIR_ATTEMPTS=1
REQUEST_TIMEOUT_SECONDS=900
MODEL_ATTEMPT_TIMEOUT_SECONDS=150
PARTY_START_MODEL_ATTEMPT_TIMEOUT_SECONDS=300
RATE_LIMIT_RETRY_ATTEMPTS=1
RATE_LIMIT_RETRY_DEFAULT_WAIT_SECONDS=1
RATE_LIMIT_RETRY_MAX_WAIT_SECONDS=10

LOG_LEVEL=INFO
LOG_PROMPTS=false
SERVICE_CALL_LOG_RETENTION_DAYS=0
POST_TURN_HELPERS_INLINE=false
